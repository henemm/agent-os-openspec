+_MERGE_CONTINUE_RE = re.compile(r"--con(?:t(?:i(?:n(?:u(?:e)?)?)?)?)?")
+# Zeichen, die bash ungequotet zu weiteren Woertern expandiert (Glob, Klammer, `~`).
+_SHELL_EXPANSION_CHARS = "*?[]{}~"
+
+
+def _plain_path_token(tok: str) -> bool:
+    """Pfad ohne Shell-Expansion (`$`, Backtick, Glob, Klammer, `~`, Backslash)."""
+    return bool(tok) and not any(ch in tok for ch in "$`*?[]{}~\\")
+
+
+def _foreign_cd(seg: list, base: str) -> "str | None":
+    """Neue Basis nach `cd <ziel>`/`pushd <ziel>`; None, wenn nicht sicher bestimmbar.
+
+    Nur genau ein literales Ziel: absolut, `.` oder `./…` (ein nacktes relatives
+    Ziel liefe ueber CDPATH), ohne `..` (logisches `cd` vs. physischer Pfad).
+    Das Ziel muss ein betretbares Verzeichnis sein, sonst scheitert das `cd`.
+    """
+    if len(seg) != 2 or not _plain_path_token(seg[1]):
+        return None
+    target = seg[1]
+    if not (target.startswith("/") or target == "." or target.startswith("./")):
+        return None
+    if ".." in target.split("/"):
+        return None
+    new = os.path.realpath(os.path.join(base, target))
+    return new if os.path.isdir(new) and os.access(new, os.X_OK) else None
+
+
+def _foreign_args_ok(sub: str, args: list) -> bool:
+    """Stehen nach dem Unterbefehl nur Tokens aus `_FOREIGN_SUB_ARGS`?
+
+    Ein Token ist eine erlaubte Option, der Wert einer vorangehenden
+    wertnehmenden Option (beliebiger Inhalt) oder - wo `paths` gilt - ein
+    schlichter Pfad. `merge` nur als `merge --continue`. Sonst False.
+    """
+    if sub == "merge":  # `merge <branch>` u. a. aendern den Arbeitsbaum
+        return len(args) == 1 and _MERGE_CONTINUE_RE.fullmatch(args[0]) is not None
+    spec = _FOREIGN_SUB_ARGS.get(sub)
+    if spec is None:
+        return False
+    i, only_paths = 0, False
+    while i < len(args):
+        tok = args[i]
+        if only_paths or not tok.startswith("-"):
+            if not (spec["paths"] and _plain_path_token(tok)):
+                return False
+        elif tok == "--" and spec["paths"]:
+            only_paths = True
+        elif tok in spec["valued"]:
+            i += 1
+            if i >= len(args):
+                return False
+        elif tok not in spec["flags"] and not tok.startswith(spec["joined"]):
+            return False
+        i += 1
