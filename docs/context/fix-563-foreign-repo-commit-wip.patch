+# genannten Optionen: `flags` ohne Wert, `valued` mit Wert im naechsten Token,
+# `joined` als zusammengeschriebene Form (`-mText`, `--message=Text`), `paths`:
+# weitere Nicht-Options-Tokens (und alles nach `--`) sind Pfade. Eingebaute
+# Unterbefehle (kein Alias kann sie ueberdecken), die weder Arbeitsbaum,
+# Repo-Zuordnung noch Config aendern; `checkout`, `switch`, `reset`, `init`,
+# `config` u. a. koennten das Ziel vor dem Commit umbiegen (F002/F003/F006).
+_FOREIGN_SUB_ARGS = {
+    "add": {"flags": frozenset({"-A", "--all", "-u", "--update", "-v", "--verbose"}),
+            "valued": frozenset(), "joined": (), "paths": True},
+    "status": {"flags": frozenset({"-s", "--short", "-b", "--branch", "--porcelain"}),
+               "valued": frozenset(), "joined": (), "paths": False},
+    "commit": {"flags": frozenset({
