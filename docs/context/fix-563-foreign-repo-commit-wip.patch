+def _foreign_git_call(seg: list, base: str) -> "tuple[str, str] | None":
+    """(Unterbefehl, Zielverzeichnis) eines direkten `git`-Aufrufs; None bei Zweifel.
+
+    Einzige globale Option ist `-C <pfad>` (kumulativ, physisch wie git selbst);
+    `-c`, `--git-dir`, `--work-tree`, `--no-pager` u. a. ergeben None. Die
+    Argumente des Unterbefehls prueft `_foreign_args_ok`.
+    """
+    target, i = base, 1
+    while i < len(seg) and seg[i] == "-C":
+        if i + 1 >= len(seg) or not _plain_path_token(seg[i + 1]):
+            return None
+        target = os.path.realpath(os.path.join(target, seg[i + 1]))
+        i += 2
+    if i >= len(seg) or not _foreign_args_ok(seg[i], seg[i + 1:]):
+        return None
+    return seg[i], target
+
+
+def _git_common_dir(path: str) -> "str | None":
+    """`git rev-parse --git-common-dir` als realpath; None ohne Repo oder bei Fehler."""
+    import subprocess
+    if not os.path.isdir(path):
+        return None
+    out = subprocess.run(["git", "rev-parse", "--git-common-dir"], cwd=path,
+                         capture_output=True, text=True, timeout=5)
+    common = out.stdout.strip()
+    if out.returncode != 0 or not common:
+        return None
+    return os.path.realpath(os.path.join(path, common))
+
+
+def _is_foreign_common_dir(common: "str | None", own: str) -> bool:
+    """Anderes Repo als `own`? Vergleich per Datei-Identitaet (st_dev/st_ino),
+    nicht per Pfadstring: case-insensitive Dateisysteme und Bind-Mounts (F004).
+    Kein Repo oder jeder Fehler beim Vergleich -> nicht fremd."""
+    if common is None:
+        return False
+    try:
+        return not os.path.samefile(common, own)
+    except OSError:
+        return False
+
+
+def _has_unquoted_expansion(command: str) -> bool:
+    """Steht ein Glob-/Klammer-/`~`-Zeichen ausserhalb von Quotes und Escapes?
+
+    bash expandiert es zu weiteren Woertern (`-m {x,--trailer=a}` ergibt die
+    Option `--trailer`); der Lexer liefert die Tokens schon entquotet, deshalb
+    die Pruefung am Rohtext. Konservativ: auch Kommentare zaehlen mit.
+    """
+    quote, escaped = None, False
+    for ch in command:
+        if escaped:
+            escaped = False
+        elif quote:
+            if ch == quote:
+                quote = None
+            elif ch == "\\" and quote == '"':
+                escaped = True
+        elif ch == "\\":
+            escaped = True
+        elif ch in "'\"":
+            quote = ch
+        elif ch in _SHELL_EXPANSION_CHARS:
+            return True
+    return False
+
+
+def _is_and_chain(command: str, tokens: list) -> bool:
+    """Nur `&&`-verkettete, einfache Kommandos ohne Expansion und Steuerzeichen.
+
+    Am Rohtext: jedes `$` und jeder Backtick, auch in doppelten Quotes (F007),
+    ungequotete Glob-/Klammer-/`~`-Zeichen, jeder Backslash und jedes
+    Steuerzeichen ausser Tab -> Zweifel. Backslash und Zeilenumbruch auch in
+    Quotes (F010): der Lexer entfernt `\\<LF>` naiv, bei `\\\\<LF>` bleibt der
+    Zeilenumbruch fuer bash aber ein Befehlstrenner (#572); `\\r` trennt der
+    Lexer anders als bash. Bei den Tokens: `;` und Zeilenumbruch laufen nach
+    einem gescheiterten `cd` weiter (F001); `||`, `|`, `&`, Klammern und
+    Umleitungen -> Zweifel.
+    """
+    if "$" in command or "`" in command or "\\" in command:
+        return False
+    if _has_unquoted_expansion(command):
+        return False
+    if any(unicodedata.category(ch) == "Cc" and ch != "\t" for ch in command):
+        return False
+    return not any(_is_git_redirect(t) or (_is_git_separator(t) and t != "&&")
+                   for t in tokens)
+
+
+def _all_commits_foreign(command: str, cwd: Path) -> bool:
+    """Kern von `_commit_in_foreign_repo`; jeder Zweifel ergibt False."""
+    tokens, segments = _git_lex(command), _git_segments(command)
+    if not tokens or not segments or git_runs_foreign_code(command):
+        return False
+    if not _is_and_chain(command, tokens):
+        return False
+    base, targets = os.path.realpath(cwd), []
+    for seg in segments:
+        if seg[0] in ("cd", "pushd"):
+            base = _foreign_cd(seg, base)
+            if base is None:
+                return False
+        elif seg[0] == "git":
+            call = _foreign_git_call(seg, base)
+            if call is None:
+                return False
+            if call[0] in ("commit", "merge"):
+                targets.append(call[1])
+        else:
+            return False  # Env-Praefix, Wrapper, Shell, Schluesselwort, eval, ...
+    own = _git_common_dir(str(_root))
+    if not targets or own is None:
+        return False
+    return all(_is_foreign_common_dir(_git_common_dir(t), own) for t in targets)
+
+
+def _commit_in_foreign_repo(command: str, cwd: Path) -> bool:
+    """Entsteht JEDER Commit des Befehls sicher in einem fremden Repo? (#563)
+
+    Fremd = anderes `git rev-parse --git-common-dir` (Datei-Identitaet) als das
+    Sitzungsprojekt `_root`; Hauptrepo und Worktrees teilen es und zaehlen als
+    eigen. Nur `&&`-Ketten aus `cd`/`pushd` und `git [-C <pfad>] add|status|
+    commit|merge --continue` mit Optionen aus der Positivliste `_FOREIGN_SUB_ARGS`,
+    ohne `$`, Backtick und Umleitung. Fail-closed: nur ein belegter Weg fuehrt zu True, jede Unklarheit und
+    jede Ausnahme ergibt False, also das bisherige Verhalten (Gates greifen).
+    """
+    try:
+        return _all_commits_foreign(command, cwd)
+    except Exception:
+        return False
